# Copy to .env and fill in. Never commit .env.
ZERNIO_API_KEY=
# Any long random string; you choose it, Zernio uses it to sign webhooks.
# Generate one with: uv run python -m probe.setup gen-secret
ZERNIO_WEBHOOK_SECRET=
# Optional: pin the Instagram account id (otherwise the first Instagram account is used)
ZERNIO_IG_ACCOUNT_ID=
